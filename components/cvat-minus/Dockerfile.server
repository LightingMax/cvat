# The fork uses the CVAT 2.84.0 runtime and its locked Python/system dependencies.
FROM cvat/server:v2.84.0@sha256:db57fd80c929b8a2c6ae875a5781a5750b73397495121cdd6d736ff3fc04b51c
COPY cvat/apps/dataset_manager/task.py /opt/cvat/cvat/apps/dataset_manager/task.py
COPY cvat/apps/engine/models.py cvat/apps/engine/views.py /opt/cvat/cvat/apps/engine/
COPY cvat/apps/engine/migrations/0111_annotation_merge_submission.py cvat/apps/engine/migrations/0112_merge_minus_calibration.py /opt/cvat/cvat/apps/engine/migrations/
